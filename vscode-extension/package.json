{
  "name": "neon-mdf-tools",
  "displayName": "NEON-MDF Tools",
  "description": "Build, flash, monitor, configure and debug GT32U2086 applications with NEON-MDF.",
  "publisher": "neon-mdf",
  "version": "0.1.5",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:CMakePresets.json",
    "workspaceContains:examples/*/CMakePresets.json"
  ],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "neon-mdf",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier for this NEON-MDF task execution."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "neonMdf.createApp",
        "title": "NEON-MDF: Create New App..."
      },
      {
        "command": "neonMdf.selectSdkPath",
        "title": "NEON-MDF: Select SDK Path..."
      },
      {
        "command": "neonMdf.selectTarget",
        "title": "NEON-MDF: Select Target"
      },
      {
        "command": "neonMdf.selectTransport",
        "title": "NEON-MDF: Select Transport (UART)"
      },
      {
        "command": "neonMdf.selectPort",
        "title": "NEON-MDF: Select Serial Port"
      },
      {
        "command": "neonMdf.build",
        "title": "NEON-MDF: Build"
      },
      {
        "command": "neonMdf.flash",
        "title": "NEON-MDF: Flash"
      },
      {
        "command": "neonMdf.buildFlashMonitor",
        "title": "NEON-MDF: Build + Flash + Log"
      },
      {
        "command": "neonMdf.debug",
        "title": "NEON-MDF: Debug"
      },
      {
        "command": "neonMdf.menuconfig",
        "title": "NEON-MDF: menuconfig"
      },
      {
        "command": "neonMdf.openMonitor",
        "title": "NEON-MDF: Serial Monitor"
      },
      {
        "command": "neonMdf.selectApp",
        "title": "NEON-MDF: Select Application..."
      },
      {
        "command": "neonMdf.openBoardTools",
        "title": "NEON-MDF: Open Board Tools"
      }
    ],
    "configuration": {
      "title": "NEON-MDF",
      "properties": {
        "neonMdf.baudRate": {
          "type": "integer",
          "default": 19200,
          "description": "Application UART/Serial Monitor baud; independent of programming baud.",
          "minimum": 1
        },
        "neonMdf.gt32u2086FlashBaudRate": {
          "type": "integer",
          "minimum": 1,
          "default": 19200,
          "description": "GT32U2086 UART programming baud rate; must match the board ROMCODE. Passed when the CMake target runs; does not change the chip baud rate."
        },
        "neonMdf.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Optional default SDK path on the workspace host. Use Select SDK Path to choose a path for the current workspace or enable automatic detection."
        },
        "neonMdf.target": {
          "type": "string",
          "default": "GT32U2086",
          "description": "GT32U2086 device preset.",
          "enum": [
            "GT32U2086"
          ]
        },
        "neonMdf.transport": {
          "type": "string",
          "enum": [
            "uart"
          ],
          "default": "uart",
          "description": "ROMCODE UART programming: select boot mode 100 and press RESET when the loader is ready."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neonMdf",
          "title": "NEON-MDF",
          "icon": "resources/neon-mdf.svg"
        }
      ]
    },
    "views": {
      "neonMdf": [
        {
          "id": "neonMdf.controlPanel",
          "name": "Board Tools"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "vsix": "npm run package && vsce package --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "esbuild": "^0.23.0",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ftel-cdc/neon_mdf.git",
    "directory": "vscode-extension"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
