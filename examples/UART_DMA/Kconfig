menu "FU2 example configuration"

config FU2_EXAMPLE_FIXED_CLOCK_HZ
    int "Fixed FPGA clock (Hz; 0 uses normal SDK clock setup)"
    range 0 1000000000
    default 10000000
    help
        Must match the actual FPGA clock. Zero retains the SDK SystemInit settings.

config FU2_EXAMPLE_RX_TIMEOUT_POLLS
    int "Console RX polling budget"
    range 1 100000000
    default 10000

endmenu

menu "UART DMA example"

config UART_DMA_TIMEOUT_POLLS
    int "UART DMA polling budget"
    range 1000 100000000
    default 10000000
    help
        Maximum main-loop iterations while waiting for a DMA transfer.
        This is not a time in milliseconds. Paste the RX pattern after READY.

endmenu
