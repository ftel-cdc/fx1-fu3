rsource "../cmake/FPGA_Kconfig"

menu "UART RX Interrupt Configuration"

    config UART_RX_INTERRUPT_RING_BUF_SIZE
        int "UART RX Ring Buffer Size"
        range 1 4096
        default 128
        help
            Size of the internal ring buffer for UART RX interrupt handling.
            Number of byte slots, each stored in an aligned 32-bit word on FU2.
            Any positive size is supported, not only powers of 2.

    config UART_RX_INTERRUPT_TX_TIMEOUT_POLLS
        int "UART TX Timeout Polls"
        range 1 100000000
        default 1000000
        help
            Maximum polling loops allowed when transmitting an echo character over UART.

endmenu
