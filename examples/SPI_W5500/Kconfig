rsource "../cmake/FPGA_Kconfig"

menu "SPI W5500 example"

config SPI_W5500_SCK_HZ
    int "Initial SPI0 SCK frequency (Hz)"
    range 1000 5000000
    default 1000000
    help
        Starts in mode 3, MSB first, hardware SS0. The divider is rounded
        up so the actual SCK does not exceed this requested frequency.

config SPI_W5500_TIMEOUT_POLLS
    int "SPI polling budget per transfer"
    range 1000 100000000
    default 1000000
    help
        Polling iterations, not milliseconds; includes the final-frame guard.

config SPI_W5500_B2B_TRIES
    int "Read attempts per B2B gap and mode/speed case"
    range 10 100000
    default 1000
    help
        Menu key b tests modes 0 and 3 at requested SCK 1/3/5/10 MHz.
        Frequencies the divider cannot generate exactly are skipped.
        Each case sweeps byte pauses from 10 down to 0 SCK periods.
        Each attempt reads VERSIONR and the same 32 socket 0 TX SRAM bytes.
        All cases use the same CRC32 reference, first validated in mode 0
        at 1 MHz with a 10-SCK pause. An unstable first baseline stops the
        whole sweep; other cases failing at gap 10 skip their lower gaps.
        No W5500 registers or SRAM are written by this sweep.

endmenu
