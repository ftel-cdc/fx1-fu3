foreach(required VP ELF LOG)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Runner thiếu -D${required}=...; chọn VP bằng -DNEON_FX1_VP_EXECUTABLE=/path/to/fx1_soc khi configure. Build ELF không cần VP.")
  endif()
endforeach()
if(NOT EXISTS "${VP}")
  message(FATAL_ERROR "Không có executable VP: ${VP}. Chọn -DNEON_FX1_VP_EXECUTABLE=/path/to/fx1_soc hoặc đặt fx1_soc trên PATH; build ELF không cần VP.")
endif()
if(NOT EXISTS "${ELF}")
  message(FATAL_ERROR "Không có ELF: ${ELF}. Build executable trước hoặc dùng target run-*-vp.")
endif()
if(NOT DEFINED SIM_TIMEOUT_MS)
  set(SIM_TIMEOUT_MS 500)
endif()
execute_process(COMMAND "${VP}" --fw "${ELF}" --timeout-ms ${SIM_TIMEOUT_MS}
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 60)
file(WRITE "${LOG}" "${output}")
if(NOT DEFINED EXPECT)
  set(EXPECT BAYER_AEC_INIT)
endif()
if(NOT status STREQUAL "0" OR NOT output MATCHES "${EXPECT} PASS" OR
    NOT output MATCHES "RESULT PASS")
  message(FATAL_ERROR "Bring-up ftel_isp FAIL (${status}); xem ${LOG}")
endif()
message(STATUS "ftel_isp ${EXPECT} PASS; log: ${LOG}")
