menu "PWM Output Testcase Configuration"

    config PWM_OUTPUT_TEST_PERIOD
        int "PWM Period Ticks (Base resolution)"
        default 1000
        help
            Dung luong tick chu ky PWM (vi du: 1000 tương đương 100% resolution).

    config PWM_OUTPUT_TEST_PRESCALER
        int "PWM Clock Prescaler"
        default 15
        help
            He so chia tan clock cho khoi PWM/TIM.

endmenu