{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25 },
  "configurePresets": [
    {
      "name": "FU2",
      "displayName": "FU2 standalone example",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/FU2",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${fileDir}/../../neon-mdf/cmake/toolchain/arm-none-eabi.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "NEON_MDF_TARGET": "FU2",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "FU2", "configurePreset": "FU2" }
  ]
}
