menu "GT32U2086 example configuration"

config GT32U2086_EXAMPLE_FIXED_CLOCK_HZ
    int "Fixed FPGA clock (Hz; 0 uses normal SDK clock setup)"
    range 0 1000000000
    default 10000000
    help
        Must match the actual FPGA clock. Zero retains the SDK SystemInit settings.

config GT32U2086_EXAMPLE_RX_TIMEOUT_POLLS
    int "Console RX polling budget"
    range 1 100000000
    default 10000

endmenu

menu "RTC calendar"

config RTC_CALENDAR_PRESCALER
    int "RTC source divider (source Hz / 100)"
    range 1 67108863
    default 360
    help
        Match the actual RTC source. The reference configuration uses 360;
        verify second timing on the board rather than inferring it from SystemCoreClock.

endmenu

