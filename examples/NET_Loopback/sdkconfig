#
# FTEL FX1 network stack
#
CONFIG_NEON_MDF_NET=y
CONFIG_NEON_MDF_NET_TCPIP_PRIORITY=3
CONFIG_NEON_MDF_NET_TCPIP_STACK_BYTES=4096
CONFIG_NEON_MDF_NET_MEM_SIZE=32768
CONFIG_NEON_MDF_NET_PBUF_POOL_SIZE=24
CONFIG_NEON_MDF_NET_TCP_WND_MSS=4
CONFIG_NEON_MDF_NET_DHCP=y
CONFIG_NEON_MDF_NET_DNS=y
