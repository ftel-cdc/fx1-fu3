menu "GPIO_Input_Output"

config GPIO_IO_FIXED_CLOCK_HZ
    int "Fixed FPGA clock (Hz; 0 uses normal SDK clock setup)"
    range 0 1000000000
    default 10000000
    help
        Phai khop clock FPGA thuc te. Gia tri 0 dung SystemInit cua SDK.
        Clock dung de tinh baud UART0 cho printf.

endmenu
