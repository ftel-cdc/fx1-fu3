menu "GT32U2086 example configuration"

config GT32U2086_EXAMPLE_FIXED_CLOCK_HZ
    int "Fixed FPGA clock (Hz; 0 uses normal SDK clock setup)"
    range 0 1000000000
    default 10000000
    help
        Must match the actual FPGA clock. Zero retains the SDK SystemInit settings.

config GT32U2086_EXAMPLE_RX_TIMEOUT_POLLS
    int "Console RX polling budget"
    range 1 100000000
    default 10000

endmenu

menu "PWM Output Example Configuration"

    config PWM_OUTPUT_TEST_PERIOD
        int "PWM Period Ticks (Base resolution)"
        default 1000
        help
            use the amount of PWM period ticks (full text: 1000 equivalent to 100% resolution).

    config PWM_OUTPUT_TEST_PRESCALER
        int "PWM Clock Prescaler"
        default 15
        help
            PWM/TIM block clock prescaler.

endmenu