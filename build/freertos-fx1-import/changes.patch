+    registers:
+      - name: COMMON_VER_DATE
+        offset: 0x00000000
+        size: 32
+        access: ro
+        reset: 0x18102026
+        description: Fixed register-map revision date, BCD; not a build timestamp.
+        fields:
+          - name: YEAR
+            bit_offset: 0
+            bit_width: 16
+            access: ro
+            reset: 0x00002026
+            description: 'Version Date - Year
+
+              Year, BCD.  Reads 0x2026 for the current map.'
+          - name: MONTH
+            bit_offset: 16
+            bit_width: 8
+            access: ro
+            reset: 0x00000010
+            description: 'Version Date - Month
+
+              Month, BCD.'
+          - name: DAY
+            bit_offset: 24
+            bit_width: 8
+            access: ro
+            reset: 0x00000018
+            description: 'Version Date - Day
