+# Full tuning is always enabled by the application.
+APP_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+BUILD_DIR := $(APP_DIR)/build/FX1
+
+.PHONY: all build clean
+
+all: build
