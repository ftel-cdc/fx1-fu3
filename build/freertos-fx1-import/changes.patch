+# BEGIN ISP: sinh bởi tools/import_fx1_isp.py; sửa nguồn CSR rồi nhập lại.
+# CSR v1.07: FTEL_IP_ISP_CSR_v1.07.xlsx; SHA256 8a8dfa3eca6f2df26d26c4783b77bbc75373abcb15460342bf072871122961c5
+# regmap v1.07: regmap-v1.07.h; SHA256 44c726159a5f5ff05f6ef5eb913a760078d0991bbffce2d799737ba963e831e3
+  - name: ISP
+    base: 0x11000000
+    description: ISP FX1 v1.07; đủ register/field từ sheet Flat Registers của CSR. Địa chỉ base theo BSP VP_FX1_V3.0;
