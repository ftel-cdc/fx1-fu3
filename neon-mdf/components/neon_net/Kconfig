config NEON_MDF_NET
    bool "Build Neon network manager (lwIP 2.2.1 over neon_eth)"
    default n
    depends on NEON_MDF_DRIVER_ETH
    help
        lwIP TCP/IPv4 stack on FreeRTOS, one Ethernet interface owned by the
        stack's tcpip thread, PHY link tracking, DHCP or static IPv4.
        The application adds it with neon_mdf_add_net() after
        neon_mdf_add_freertos() and uses the lwIP socket/netconn/raw APIs.

if NEON_MDF_NET

config NEON_MDF_NET_TCPIP_PRIORITY
    int "tcpip thread priority"
    default 3
    range 1 31
    help
        FreeRTOS priority of the lwIP tcpip thread. It must be below
        configMAX_PRIORITIES of the application. The thread owns the
        Ethernet driver; tasks above it delay packet processing.

config NEON_MDF_NET_TCPIP_STACK_BYTES
    int "tcpip thread stack (bytes)"
    default 4096
    range 2048 65536

config NEON_MDF_NET_MEM_SIZE
    int "lwIP heap for TX segments and control blocks (bytes)"
    default 32768
    range 8192 1048576

config NEON_MDF_NET_PBUF_POOL_SIZE
    int "RX packet buffers (1516 bytes each)"
    default 24
    range 8 256

config NEON_MDF_NET_TCP_WND_MSS
    int "TCP receive window and send buffer (multiples of 1460-byte MSS)"
    default 4
    range 2 32

config NEON_MDF_NET_DHCP
    bool "DHCP client"
    default y

config NEON_MDF_NET_DNS
    bool "DNS resolver"
    default y

config NEON_MDF_NET_LOOPBACK
    bool "Loop traffic to the interface's own address inside the stack"
    default y
    help
        y: packets to the interface's own IPv4 address never reach the MAC
        (normal on a LAN, where a switch does not return a frame to its
        sender). n: they leave through the MAC and must come back from the
        line, which exercises driver, DMA and PHY on the VP with
        --eth-peer loopback (ARP, ICMP, UDP and TCP to the own address).

config NEON_MDF_NET_LINK_POLL_MS
    int "PHY link poll period (ms)"
    default 500
    range 50 10000

config NEON_MDF_NET_DEBUG
    bool "lwIP assertions report through the console, statistics on"
    default n

endif
