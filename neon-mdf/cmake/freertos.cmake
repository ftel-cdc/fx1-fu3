# Integrate the upstream Cortex-M0 port and the application's FreeRTOSConfig.h.
function(neon_mdf_add_freertos TARGET_NAME CONFIG_DIR)
  if(TARGET freertos_kernel)
    return()
  endif()
  if(NOT TARGET_NAME STREQUAL "GT32U2086")
    message(FATAL_ERROR "FreeRTOS integration supports GT32U2086 only")
  endif()
  add_library(freertos_config INTERFACE)
  target_include_directories(freertos_config SYSTEM INTERFACE ${CONFIG_DIR})
  target_compile_definitions(freertos_config INTERFACE projCOVERAGE_TEST=0 GT32U2086)
  target_link_libraries(freertos_config INTERFACE ${NEON_MDF_DEVICE_TARGET})
  target_include_directories(freertos_config INTERFACE ${NEON_MDF_PATH}/components/driver)
  set(FREERTOS_PORT GCC_ARM_CM0 CACHE STRING "" FORCE)
  set(FREERTOS_HEAP 4 CACHE STRING "" FORCE)
  add_subdirectory(${NEON_MDF_PATH}/rtos/FreeRTOS-Kernel ${CMAKE_BINARY_DIR}/FreeRTOS-Kernel)
  include(${NEON_MDF_PATH}/cmake/arch/cortex-m.cmake)
  neon_mdf_apply_cortex_m_arch(freertos_kernel cortex-m0)
  neon_mdf_apply_cortex_m_arch(freertos_kernel_port cortex-m0)
endfunction()
