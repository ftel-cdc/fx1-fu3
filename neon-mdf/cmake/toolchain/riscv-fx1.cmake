# Toolchain cho target FX1 RV32IMAFC/ilp32f. Không đổi toolchain CH32V003.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
  NEON_FX1_TOOLCHAIN_DIR NEON_FX1_TOOLCHAIN_PREFIX)

set(NEON_FX1_TOOLCHAIN_DIR "" CACHE PATH "Thu muc bin cua xPack RISC-V GCC")
if(NOT NEON_FX1_TOOLCHAIN_DIR AND DEFINED ENV{NEON_FX1_TOOLCHAIN_DIR})
  set(NEON_FX1_TOOLCHAIN_DIR "$ENV{NEON_FX1_TOOLCHAIN_DIR}")
endif()
if(NOT NEON_FX1_TOOLCHAIN_DIR)
  set(NEON_FX1_TOOLCHAIN_DIR "$ENV{FX1_TOOLCHAIN_DIR}")
endif()
if(NOT NEON_FX1_TOOLCHAIN_DIR)
  set(NEON_FX1_TOOLCHAIN_DIR "$ENV{TOOLDIR}")
endif()
set(NEON_FX1_TOOLCHAIN_PREFIX riscv-none-elf- CACHE STRING "Tien to toolchain FX1")
foreach(_tool gcc g++ objcopy objdump size readelf)
  string(REPLACE "+" "x" _key "${_tool}")
  find_program(NEON_FX1_${_key} NAMES ${NEON_FX1_TOOLCHAIN_PREFIX}${_tool}
    HINTS ${NEON_FX1_TOOLCHAIN_DIR} REQUIRED)
endforeach()
set(CMAKE_C_COMPILER "${NEON_FX1_gcc}")
set(CMAKE_CXX_COMPILER "${NEON_FX1_gxx}")
set(CMAKE_ASM_COMPILER "${NEON_FX1_gcc}")
set(CMAKE_OBJCOPY "${NEON_FX1_objcopy}" CACHE FILEPATH "")
set(CMAKE_OBJDUMP "${NEON_FX1_objdump}" CACHE FILEPATH "")
set(CMAKE_SIZE "${NEON_FX1_size}" CACHE FILEPATH "")
set(CMAKE_READELF "${NEON_FX1_readelf}" CACHE FILEPATH "")
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
set(CMAKE_C_FLAGS_INIT "-O2 -g -std=c11 -ffreestanding -fno-builtin -ffunction-sections -fdata-sections -Wall -Wextra")
set(CMAKE_ASM_FLAGS_INIT "-g -x assembler-with-cpp")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -nostartfiles -Wl,--gc-sections -Wl,--no-warn-rwx-segments -Wl,--print-memory-usage")
