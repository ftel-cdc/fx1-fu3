            <field>
              <name>DE_TO_RE</name>
              <description>DE-to-RE transition time in bits [15:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>RE_TO_DE</name>
              <description>RE-to-DE transition time in bits [31:16]</description>
