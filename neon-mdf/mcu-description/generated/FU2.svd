<?xml version="1.0" encoding="utf-8"?>
<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>FPTTelecom</vendor>
  <name>FU2</name>
  <description>FU2 - FPT Telecom FU2 MCU
- Core : Cortex-M0 - up to 60MHz
- Flash: 512KB instruction Flash + 14 x 512-byte NVR slots
- RAM  : 128KB contiguous SRAM (data only)
| IP         | Address range                   |
| ---------- | ------------------------------- |
| AES        | 0x40000000 - 0x4000FFFF (64 KB) |
| QSPI_APB   | 0x44000000 - 0x4400FFFF (64 KB) |
| SYSCSR     | 0x44010000 - 0x4401FFFF (64 KB) |
| DMA0       | 0x44020000 - 0x4402FFFF (64 KB) |
| RNG        | 0x44030000 - 0x4403FFFF (64 KB) |
| CRC        | 0x44040000 - 0x4404FFFF (64 KB) |
| WDT        | 0x44050000 - 0x4405FFFF (64 KB) |
| TIM0       | 0x44060000 - 0x4406FFFF (64 KB) |
| TIM1       | 0x44070000 - 0x4407FFFF (64 KB) |
| TIM2       | 0x44080000 - 0x4408FFFF (64 KB) |
| TIM3       | 0x44090000 - 0x4409FFFF (64 KB) |
| PWM0       | 0x440A0000 - 0x440AFFFF (64 KB) |
| PWM1       | 0x440B0000 - 0x440BFFFF (64 KB) |
| SPI0       | 0x440C0000 - 0x440CFFFF (64 KB) |
| UART0      | 0x440D0000 - 0x440DFFFF (64 KB) |
| UART1      | 0x440E0000 - 0x440EFFFF (64 KB) |
| GPIOC      | 0x440F0000 - 0x440FFFFF (64 KB) |
| GPIOD      | 0x44100000 - 0x4410FFFF (64 KB) |
| GPIOE      | 0x44110000 - 0x4411FFFF (64 KB) |
| GPIOF      | 0x44120000 - 0x4412FFFF (64 KB) |
| FLASH_CTRL | 0x50000000 - 0x5000FFFF (64 KB) |
| CRM        | 0x50010000 - 0x5001FFFF (64 KB) |
| DMA1       | 0x50020000 - 0x5002FFFF (64 KB) |
| GPIOA      | 0x50030000 - 0x5003FFFF (64 KB) |
| GPIOB      | 0x50040000 - 0x5004FFFF (64 KB) |
| UART2      | 0x50050000 - 0x5005FFFF (64 KB) |
| UART3      | 0x50060000 - 0x5006FFFF (64 KB) |
| UART4      | 0x50070000 - 0x5007FFFF (64 KB) |
| I2C0       | 0x50080000 - 0x5008FFFF (64 KB) |
| SPI1       | 0x50090000 - 0x5009FFFF (64 KB) |
| ADC        | 0x500A0000 - 0x500AFFFF (64 KB) |
| TIM4       | 0x500B0000 - 0x500BFFFF (64 KB) |
| TIM5       | 0x500C0000 - 0x500CFFFF (64 KB) |
| TIM6       | 0x500D0000 - 0x500DFFFF (64 KB) |
| TIM7       | 0x500E0000 - 0x500EFFFF (64 KB) |
| RTC        | 0x500F0000 - 0x500FFFFF (64 KB) |</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x00000000</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>AES</name>
      <description>AES-128 - ADVANCED ENCRYPTION STANDARD
AES : 0x40000000 - 0x4000FFFF (64 KB)
Reference: FU2_AES_Specification_v1.0.pdf
</description>
      <baseAddress>0x40000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>VERSION</name>
          <description>AES IP version register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
        </register>
        <register>
          <name>CTRL</name>
          <description>AES control register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>STATUS</name>
          <description>AES status register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000001</resetValue>
        </register>
        <register>
          <name>KEY0</name>
          <description>AES key bits [31:0]</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>KEY1</name>
          <description>AES key bits [63:32]</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>KEY2</name>
          <description>AES key bits [95:64]</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>KEY3</name>
          <description>AES key bits [127:96]</description>
          <addressOffset>0x4C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IV0</name>
          <description>Initial vector bits [31:0]</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IV1</name>
          <description>Initial vector bits [63:32]</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IV2</name>
          <description>Initial vector bits [95:64]</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IV3</name>
          <description>Initial vector bits [127:96]</description>
          <addressOffset>0x8C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DIN0</name>
          <description>Input data bits [31:0]</description>
          <addressOffset>0xC0</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DIN1</name>
          <description>Input data bits [63:32]</description>
          <addressOffset>0xC4</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DIN2</name>
          <description>Input data bits [95:64]</description>
          <addressOffset>0xC8</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DIN3</name>
          <description>Input data bits [127:96]</description>
          <addressOffset>0xCC</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DOUT0</name>
          <description>Output data bits [31:0]</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DOUT1</name>
          <description>Output data bits [63:32]</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DOUT2</name>
          <description>Output data bits [95:64]</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DOUT3</name>
          <description>Output data bits [127:96]</description>
          <addressOffset>0x10C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CTR0</name>
          <description>Counter bits [31:0] / CFB segment length</description>
          <addressOffset>0x140</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CTR1</name>
          <description>Counter bits [63:32]</description>
          <addressOffset>0x144</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CTR2</name>
          <description>Counter bits [95:64]</description>
          <addressOffset>0x148</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CTR3</name>
          <description>Counter bits [127:96]</description>
          <addressOffset>0x14C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>QSPI_APB</name>
      <description>QSPI - QUAD SERIAL PERIPHERAL INTERFACE CONTROLLER
QSPI_APB : 0x44000000 - 0x4400FFFF (64 KB)
Reference: dti_qspi_ug_rev0p0p1.pdf
</description>
      <baseAddress>0x44000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TX</name>
          <description>Transmit register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CCR</name>
          <description>Command configuration register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x03A0EC00</resetValue>
        </register>
        <register>
          <name>DLR</name>
          <description>Data length register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>AR</name>
          <description>Address register</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>ABR</name>
          <description>Alternate-byte register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>SSR</name>
          <description>Slave select register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
        </register>
        <register>
          <name>SMR</name>
          <description>Polling status mask register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>SMPR</name>
          <description>Polling status match pattern register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CFG</name>
          <description>QSPI configuration register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00001C30</resetValue>
        </register>
        <register>
          <name>CAR</name>
          <description>QSPI abort control register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>STT</name>
          <description>QSPI status register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>IMR</name>
          <description>Interrupt mask register</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>RISR</name>
          <description>Raw interrupt status register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>MISR</name>
          <description>Masked interrupt status register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>ICR</name>
          <description>Interrupt clear register (W1C)</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>FIFO</name>
          <description>FIFO programmed level register</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x301FC07F</resetValue>
        </register>
        <register>
          <name>SCLK</name>
          <description>QSPI clock divider register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>TREG0</name>
          <description>Timing register 0</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>TREG1</name>
          <description>Timing register 1</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>TREG2</name>
          <description>Timing register 2</description>
          <addressOffset>0x4C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00200000</resetValue>
        </register>
        <register>
          <name>TREG3</name>
          <description>Timing register 3</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
        </register>
        <register>
          <name>PHYCFG</name>
          <description>PHY configuration register</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00002800</resetValue>
        </register>
        <register>
          <name>PHYFCLK</name>
          <description>PHY feedback clock control register</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>RX</name>
          <description>Receive register</description>
          <addressOffset>0x5C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>PHYSTT</name>
          <description>PHY status register</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>DMACTRL</name>
          <description>DMA control register</description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <access>read-write</access>
