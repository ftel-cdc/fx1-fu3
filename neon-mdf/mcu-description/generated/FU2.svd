              <description>Active-low sleep-state hold request</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPHOLDACKN</name>
              <description>Active-low sleep-state hold acknowledgment</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLEEPING</name>
