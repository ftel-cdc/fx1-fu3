              <name>ADDR_NACK</name>
              <description>Address NACK received</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATA_NACK</name>
              <description>Data NACK received</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_FULL</name>
              <description>TX FIFO full</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
