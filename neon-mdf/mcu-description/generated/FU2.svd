          </fields>
        </register>
        <register>
          <name>LCR_EXT</name>
          <description>Line Extended Control Register bit[0] DLS_E | bit[1] ADDR_MATCH | bit[2] SEND_ADDR | bit[3] TRANSMIT_MODE</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLS_E</name>
              <description>Extend the data length to 9 bits</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_MATCH</name>
              <description>Enable address matching in 9-bit mode</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SEND_ADDR</name>
              <description>Request transmission of the address byte</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRANSMIT_MODE</name>
              <description>9-bit TX mode: 0=8-bit THR with separate address control, 1=9-bit THR</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKS</name>
          <description>Clock Status Register bit[0] CLK_FAILURE | bit[12:1] ADDR_FAILURE | bit[13] CMD_FAILURE; read-to-clear</description>
          <addressOffset>0x40</addressOffset>
