        </register>
        <register>
          <name>TCR</name>
          <description>Transceiver Control Register bit[0] RS485_EN | bit[1] RE_POL | bit[2] DE_POL | bit[4:3] XFER_MODE | bit[5] DE_EN | bit[6] RE_EN</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RS485_EN</name>
              <description>Enable RS485 mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RE_POL</name>
              <description>Select Receiver Enable polarity</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DE_POL</name>
              <description>Select Driver Enable polarity</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>XFER_MODE</name>
              <description>Select the RS485 transfer mode in bits [4:3]</description>
              <bitOffset>3</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DE_EN</name>
              <description>Control the Driver Enable output</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RE_EN</name>
              <description>Control the Receiver Enable output</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DET</name>
          <description>Driver Output Enable Timing Register bit[7:0] DE_ASSERTION_TIME | bit[23:16] DE_DEASSERTION_TIME</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DE_ASSERTION_TIME</name>
              <description>DE assertion time in bits [7:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>DE_DEASSERTION_TIME</name>
              <description>DE deassertion time in bits [23:16]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TAT</name>
