              <name>ADDR_NACK_EN</name>
              <description>Enable interrupt for address-NACK</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATA_NACK_EN</name>
              <description>Enable interrupt for data-NACK</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_FULL_EN</name>
              <description>Enable interrupt for TX FIFO full</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_EMPTY_EN</name>
              <description>Enable interrupt for TX FIFO empty</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_PROG_FULL_EN</name>
              <description>Enable interrupt for TX FIFO programmable-full</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_PROG_EMPTY_EN</name>
              <description>Enable interrupt for TX FIFO programmable-empty</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_FULL_EN</name>
              <description>Enable interrupt for RX FIFO full</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_EMPTY_EN</name>
              <description>Enable interrupt for RX FIFO empty</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_FULL_EN</name>
              <description>Enable interrupt for RX FIFO programmable-full</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_EMPTY_EN</name>
              <description>Enable interrupt for RX FIFO programmable-empty</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SCL_STUCK_LOW_EN</name>
