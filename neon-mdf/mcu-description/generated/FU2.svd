          <fields>
            <field>
              <name>DATA</name>
              <description>Receive data; the effective width is determined by CMDCONF.LEN in master mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKS</name>
          <description>Clock Status Register bit[0] CLK_FAILURE | bit[8:1] ADDR_FAILURE | bit[9] CMD_FAILURE</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_FAILURE</name>
              <description>Core-clock stoppage detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_FAILURE</name>
              <description>Address of the first APB command affected by the clock failure</description>
              <bitOffset>1</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>CMD_FAILURE</name>
              <description>Failed command type: 0=write, 1=read</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STT</name>
          <description>Status Register bit[0] INT_TXFF_FULL | bit[1] INT_TXFF_EMPTY | bit[2] INT_RXFF_FULL | bit[3] INT_RXFF_EMPTY | bit[4] INT_TXFF_PROG_FULL | bit[5] INT_TXFF_PROG_EMPTY | bit[6] INT_RXFF_PROG_FULL | bit[7] INT_RXFF_PROG_EMPTY</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>INT_TXFF_FULL</name>
              <description>TX FIFO full</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_EMPTY</name>
              <description>TX FIFO empty</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_FULL</name>
              <description>RX FIFO full</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_EMPTY</name>
              <description>RX FIFO empty</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_PROG_FULL</name>
              <description>TX FIFO reached the programmable-full threshold</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_PROG_EMPTY</name>
              <description>TX FIFO reached the programmable-empty threshold</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_PROG_FULL</name>
              <description>RX FIFO reached the programmable-full threshold</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_PROG_EMPTY</name>
              <description>RX FIFO reached the programmable-empty threshold</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STT_DMA</name>
          <description>DMA Status Register bit[0] TRAN_DONE_RX | bit[1] TRAN_DONE_TX | bit[2] DMA_BUSY_RX | bit[3] DMA_BUSY_TX</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TRAN_DONE_RX</name>
              <description>DMA RX flag: 0=incomplete, 1=complete</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRAN_DONE_TX</name>
              <description>DMA TX flag: 0=incomplete, 1=complete</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMA_BUSY_RX</name>
              <description>Circular RX reconfiguration readiness: 1=allowed, 0=not yet allowed</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMA_BUSY_TX</name>
              <description>Circular TX reconfiguration readiness: 1=allowed, 0=not yet allowed</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_RX</name>
          <description>DMA RX Control Register bit[0] ENABLE | bit[2:1] MAX_BURST_LEN | bit[3] BURST_MODE | bit[19:4] TOTAL_BYTES | bit[20] CIRCULAR_MODE | bit[21] CLEAR</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable the DMA RX channel</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MAX_BURST_LEN</name>
              <description>Singles-per-burst code: 0/1/2/3 correspond to 2/4/8/16</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BURST_MODE</name>
              <description>0=SINGLE only, 1=BURST</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TOTAL_BYTES</name>
              <description>Total DMA RX bytes; DTI requires a multiple of 4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>CIRCULAR_MODE</name>
              <description>0=one-shot transfer, 1=continuous transfers</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLEAR</name>
              <description>Clear transfer-complete state and rearm one-shot configuration</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_TX</name>
          <description>DMA TX Control Register bit[0] ENABLE | bit[2:1] MAX_BURST_LEN | bit[3] BURST_MODE | bit[19:4] TOTAL_BYTES | bit[20] CIRCULAR_MODE | bit[21] CLEAR</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable the DMA TX channel</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MAX_BURST_LEN</name>
              <description>Singles-per-burst code: 0/1/2/3 correspond to 2/4/8/16</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BURST_MODE</name>
              <description>0=SINGLE only, 1=BURST</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TOTAL_BYTES</name>
              <description>Total DMA TX bytes; DTI requires a multiple of 4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>CIRCULAR_MODE</name>
              <description>0=one-shot transfer, 1=continuous transfers</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLEAR</name>
              <description>Clear transfer-complete state and rearm one-shot configuration</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <description>UART0 - UNIVERSAL ASYNCHRONOUS RECEIVER TRANSMITTER
UART0 : 0x440D0000 - 0x440DFFFF (64 KB)
</description>
      <baseAddress>0x440D0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>RBR</name>
          <description>Receiver Buffer Register when DLAB=0 and the CPU reads</description>
          <alternateGroup>RBR_DLL_THR</alternateGroup>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>RDATA</name>
              <description>9-bit receive data in bits [8:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DLL</name>
          <description>Divisor Latch LSB when DLAB=1</description>
          <alternateGroup>RBR_DLL_THR</alternateGroup>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLSB</name>
              <description>Low 8 bits of the baud-rate divisor in bits [7:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>THR</name>
          <description>Transmitter Holding Register when DLAB=0 and CPU write</description>
          <alternateGroup>RBR_DLL_THR</alternateGroup>
          <addressOffset>0x0</addressOffset>
