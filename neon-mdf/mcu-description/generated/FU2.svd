    </peripheral>
    <peripheral>
      <name>SYSCSR</name>
      <description>SYSCSR - SYSTEM CONTROL AND STATUS REGISTERS
SYSCSR : 0x44010000 - 0x4401FFFF (64 KB)
Reference: FU2_SYSCSR_v4.xlsx
</description>
      <baseAddress>0x44010000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>VERSION</name>
          <description>SYSCSR Version bit[15:0] MINOR | bit[31:16] MAJOR</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MINOR</name>
              <description>Minor version number in bits [15:0]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>MAJOR</name>
              <description>Major version number in bits [31:16]</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_IO_CFG</name>
          <description>IO Mux Register: 16 two-bit fields in bit[31:0]</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Sixteen 2-bit mux fields; field n is located at 2*n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BOT_IO_CFG</name>
          <description>IO Mux Register: 16 two-bit fields in bit[31:0]</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Sixteen 2-bit mux fields; field n is located at 2*n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RIGHT_IO_CFG</name>
          <description>IO Mux Register: 16 two-bit fields in bit[31:0]</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Sixteen 2-bit mux fields; field n is located at 2*n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TOP_IO_CFG</name>
          <description>IO Mux Register: 16 two-bit fields in bit[31:0]</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>MODE</name>
              <description>Sixteen 2-bit mux fields; field n is located at 2*n</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_PAD_CTRL0</name>
          <description>Pad Control Register bit[11:0] IE | bit[23:12] PE (active-low pull enable)</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00F86C3F</resetValue>
          <fields>
            <field>
              <name>IE</name>
              <description>Enable the digital input path, one bit per pad</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>PE</name>
              <description>Pull-cell control active-low: 0=enabled, 1=disabled</description>
              <bitOffset>12</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_PAD_CTRL1</name>
          <description>Pad Control Register bit[11:0] DS</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00FFFFFF</resetValue>
          <fields>
            <field>
              <name>DS</name>
              <description>Coarse drive strength: 0=low, 1=high</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_PAD_CTRL2</name>
          <description>Pad Control Register bit[11:0] SL | bit[23:12] CS</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SL</name>
              <description>Slew rate: 0=slow, 1=fast</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>CS</name>
              <description>Schmitt trigger: 0=disabled, 1=enabled</description>
              <bitOffset>12</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_PAD_CTRL3</name>
          <description>Pad Control Register bit[11:0] PD | bit[23:12] PU</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PD</name>
              <description>Select pull-down, one bit per pad</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
            <field>
              <name>PU</name>
              <description>Select pull-up, one bit per pad</description>
              <bitOffset>12</bitOffset>
              <bitWidth>12</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>LEFT_PAD_CTRL4</name>
          <description>Pad Control Register bit[23:0] PDRV (2 bits per pin)</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>PDRV</name>
              <description>2-bit drive-current fields: 00=2mA, 01=4mA, 10=8mA, 11=12mA</description>
              <bitOffset>0</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>BOT_PAD_CTRL0</name>
