              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DPSTB_DONE</name>
              <description>Deep-power standby exit complete</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
