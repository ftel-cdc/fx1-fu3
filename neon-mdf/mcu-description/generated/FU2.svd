              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CPU_CTRL</name>
          <description>CPU WIC Logic Control bit[0] CPU_DEBUG | bit[2] WICENREQ | bit[3] WICENACK | bit[4] WAKEUP | bit[11:5] WICSENSE | bit[12] SLEEPHOLDREQN | bit[13] SLEEPHOLDACKN | bit[14] SLEEPING | bit[15] SLEEPDEEP | bit[16] TXEV | bit[17] SYSRESETREQ | bit[18] LOCKUP; only bits [0], [2], [12] are RW; remaining named fields are RO</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00003001</resetValue>
          <fields>
            <field>
              <name>CPU_DEBUG</name>
              <description>Suppress watchdog reset/interrupt in debug mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WICENREQ</name>
              <description>Request WIC enable from the CPU</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WICENACK</name>
              <description>CPU acknowledgment of the WIC enable request</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>WAKEUP</name>
              <description>CPU wake-up status</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
