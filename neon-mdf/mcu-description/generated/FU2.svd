          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>SMB_EN</name>
              <description>Enable SMBus</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PEC_EN</name>
              <description>Enable PEC generation/checking</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SF_EN</name>
              <description>Enable the spike filter in SMBus mode</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>QCMD_EN</name>
              <description>Enable SMBus quick-command</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALERT_EN</name>
              <description>Enable SMBus ALERT</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALERT_DEC_CLR</name>
              <description>Clear the ALERT-detect status</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PEC_ERR_CLR</name>
              <description>Clear the PEC-error status</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ICLFT</name>
          <description>RO I2C Clock Failure Detect Register bit[0] CLK_FAILURE | bit[16:1] ADDR_FAILURE | bit[17] CMD_FAILURE</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_FAILURE</name>
              <description>Clock failure detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_FAILURE</name>
              <description>Register address for the failed transaction</description>
              <bitOffset>1</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>CMD_FAILURE</name>
              <description>Command causing the failure: 0=write, 1=read</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IITR</name>
          <description>RO I2C Interrupt Status Register</description>
          <addressOffset>0x7C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TRANSFER_DONE</name>
              <description>Interrupt transfer-done active</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_NACK</name>
              <description>Interrupt address-NACK active</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DATA_NACK</name>
              <description>Interrupt data-NACK active</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_FULL</name>
              <description>Interrupt TX FIFO full active</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_EMPTY</name>
              <description>Interrupt TX FIFO empty active</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_PROG_FULL</name>
              <description>Interrupt TX FIFO programmable-full active</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TXFF_PROG_EMPTY</name>
              <description>Interrupt TX FIFO programmable-empty active</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_FULL</name>
              <description>Interrupt RX FIFO full active</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_EMPTY</name>
              <description>Interrupt RX FIFO empty active</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_FULL</name>
              <description>Interrupt RX FIFO programmable-full active</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_EMPTY</name>
              <description>Interrupt RX FIFO programmable-empty active</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SCL_STUCK_LOW</name>
              <description>Interrupt SCL stuck-low active</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SDA_STUCK_LOW</name>
              <description>Interrupt SDA stuck-low active</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>PEC_ERR</name>
              <description>PEC-error interrupt active</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADD_MATCH</name>
              <description>Interrupt address-match active</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ARB_LOST</name>
              <description>Interrupt arbitration-lost active</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ALERT_DEC</name>
              <description>Interrupt SMBus ALERT active</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>STOP_DEC</name>
              <description>STOP-detection interrupt active</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPI1</name>
      <description>SPI1 - SERIAL PERIPHERAL INTERFACE
SPI1 : 0x50090000 - 0x5009FFFF (64 KB)
</description>
      <baseAddress>0x50090000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TX</name>
          <description>Transmit Register bit[31:0] DATA</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Transmit data; the effective width is determined by CMDCONF.LEN in master mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL</name>
          <description>SPI Control Register bit[1:0] SPI_MODE | bit[2] CPOL | bit[3] CPHA | bit[4] LSB | bit[5] INT_EN | bit[6] SS_MODE | bit[7] SS_FORCE | bit[8] SS_LONG | bit[9] DMA_ENABLE</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>SPI_MODE</name>
              <description>00=legacy slave, 01=legacy master, 10=extended DDR master; 11 reserved</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>CPOL</name>
              <description>SCLK idle level: 0=low, 1=high</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CPHA</name>
              <description>Clock phase: 0=sample on the first edge, 1=sample on the second edge</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>LSB</name>
              <description>Bit order: 0=MSB first, 1=LSB first</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_EN</name>
              <description>Enable FIFO-status interrupt outputs</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SS_MODE</name>
              <description>Master-mode SS control: 0=normal, 1=manual</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SS_FORCE</name>
              <description>In manual mode: 0=keep SS active, 1=allow SS release when conditions are met</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SS_LONG</name>
              <description>Keep SS active until the TX FIFO is empty for long access sequences</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMA_ENABLE</name>
              <description>Globally enable the DMA interface (ctrl_dspi_modeable in rev1.1)</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CONFCMD</name>
          <description>Extended DDR command configuration; unused in legacy SPI mode</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00A0D800</resetValue>
          <fields>
            <field>
              <name>DDR</name>
              <description>00=SDR, 01=instruction SDR and remaining phases DDR, 11=DDR</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>INST</name>
              <description>Instruction byte</description>
              <bitOffset>2</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>INST_EN</name>
              <description>Enable instruction phase</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DIRECTION</name>
              <description>0=write, 1=read</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_EN</name>
              <description>Enable address phase</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADSIZE</name>
              <description>Address size minus one byte, 0..3</description>
              <bitOffset>13</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>ALT_EN</name>
              <description>Enable alternate-byte phase</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ABSIZE</name>
              <description>Alternate-byte size minus one byte, 0..3</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>DCYC</name>
              <description>Extended-command dummy length, 0..31</description>
              <bitOffset>18</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>DATA_EN</name>
              <description>Enable data phase</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DLR</name>
          <description>Extended-mode data length register</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA_LEN</name>
              <description>Number of data bytes to send or receive</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>AR</name>
          <description>Extended-mode command address register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ADDR</name>
              <description>Command address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>ABR</name>
          <description>Extended-mode alternate-byte register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ALT_BYTE</name>
              <description>Alternate-byte data</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>FIFO</name>
          <description>FIFO Control Register bit[7:0] TXFF_PROG_FLVL | bit[15:8] TXFF_PROG_ELVL | bit[23:16] RXFF_PROG_FLVL | bit[31:24] RXFF_PROG_ELVL</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00FF00FF</resetValue>
          <fields>
            <field>
              <name>TXFF_PROG_FLVL</name>
              <description>Programmable TX FIFO full threshold</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>TXFF_PROG_ELVL</name>
              <description>Programmable TX FIFO empty threshold</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_FLVL</name>
              <description>Programmable RX FIFO full threshold</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RXFF_PROG_ELVL</name>
              <description>Programmable RX FIFO empty threshold</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLK</name>
          <description>Clock Register bit[15:0] DIV</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DIV</name>
              <description>SCLK period = 2 x (DIV + 1) x core-clock period</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CMDCONF</name>
          <description>Command Configuration Register bit[4:0] LEN | bit[5] RD | bit[9:6] SLAVE_EN</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000027</resetValue>
          <fields>
            <field>
              <name>LEN</name>
              <description>Frame length minus 1; only 7/15/23/31 are supported, corresponding to 8/16/24/32 bits</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
            </field>
            <field>
              <name>RD</name>
              <description>Master: 1=store MISO data in the RX FIFO, 0=discard received data</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>SLAVE_EN</name>
              <description>Select SS0..SS3 as one-hot in master mode</description>
              <bitOffset>6</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TREG0</name>
          <description>Timing Register 0 bit[15:0] T_SS2CK | bit[31:16] T_CK2SS</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>T_SS2CK</name>
              <description>Number of cycles from SS assertion to SCLK generation</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>T_CK2SS</name>
              <description>Number of cycles from stopping SCLK to SS deassertion</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TREG1</name>
          <description>Timing Register 1 bit[15:0] T_B2B | bit[31:16] T_SS_TIMEOUT</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>T_B2B</name>
              <description>Delay between data bytes in core-clock cycles, including bytes within a 16/24/32-bit word</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>T_SS_TIMEOUT</name>
              <description>SS-active hold timeout; 0=disable the timeout function</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>TREG2</name>
          <description>Extended-mode timing register 2</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>T_CMD2CMD</name>
              <description>Delay between extended DDR commands in core-clock cycles</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>RX</name>
          <description>Receive Register bit[31:0] DATA</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DATA</name>
              <description>Receive data; the effective width is determined by CMDCONF.LEN in master mode</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKS</name>
          <description>Clock Status Register bit[0] CLK_FAILURE | bit[8:1] ADDR_FAILURE | bit[9] CMD_FAILURE</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>CLK_FAILURE</name>
              <description>Core-clock stoppage detected</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ADDR_FAILURE</name>
              <description>Address of the first APB command affected by the clock failure</description>
              <bitOffset>1</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>CMD_FAILURE</name>
              <description>Failed command type: 0=write, 1=read</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STT</name>
          <description>Status Register bit[0] INT_TXFF_FULL | bit[1] INT_TXFF_EMPTY | bit[2] INT_RXFF_FULL | bit[3] INT_RXFF_EMPTY | bit[4] INT_TXFF_PROG_FULL | bit[5] INT_TXFF_PROG_EMPTY | bit[6] INT_RXFF_PROG_FULL | bit[7] INT_RXFF_PROG_EMPTY</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>INT_TXFF_FULL</name>
              <description>TX FIFO full</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_EMPTY</name>
              <description>TX FIFO empty</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_FULL</name>
              <description>RX FIFO full</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_EMPTY</name>
              <description>RX FIFO empty</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_PROG_FULL</name>
              <description>TX FIFO reached the programmable-full threshold</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_TXFF_PROG_EMPTY</name>
              <description>TX FIFO reached the programmable-empty threshold</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_PROG_FULL</name>
              <description>RX FIFO reached the programmable-full threshold</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>INT_RXFF_PROG_EMPTY</name>
              <description>RX FIFO reached the programmable-empty threshold</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>STT_DMA</name>
          <description>DMA Status Register bit[0] TRAN_DONE_RX | bit[1] TRAN_DONE_TX | bit[2] DMA_BUSY_RX | bit[3] DMA_BUSY_TX</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>TRAN_DONE_RX</name>
              <description>DMA RX flag: 0=incomplete, 1=complete</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TRAN_DONE_TX</name>
              <description>DMA TX flag: 0=incomplete, 1=complete</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMA_BUSY_RX</name>
              <description>Circular RX reconfiguration readiness: 1=allowed, 0=not yet allowed</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>DMA_BUSY_TX</name>
              <description>Circular TX reconfiguration readiness: 1=allowed, 0=not yet allowed</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_RX</name>
          <description>DMA RX Control Register bit[0] ENABLE | bit[2:1] MAX_BURST_LEN | bit[3] BURST_MODE | bit[19:4] TOTAL_BYTES | bit[20] CIRCULAR_MODE | bit[21] CLEAR</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable the DMA RX channel</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MAX_BURST_LEN</name>
              <description>Singles-per-burst code: 0/1/2/3 correspond to 2/4/8/16</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BURST_MODE</name>
              <description>0=SINGLE only, 1=BURST</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TOTAL_BYTES</name>
              <description>Total DMA RX bytes; DTI requires a multiple of 4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>CIRCULAR_MODE</name>
              <description>0=one-shot transfer, 1=continuous transfers</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLEAR</name>
              <description>Clear transfer-complete state and rearm one-shot configuration</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>CTRL_TX</name>
          <description>DMA TX Control Register bit[0] ENABLE | bit[2:1] MAX_BURST_LEN | bit[3] BURST_MODE | bit[19:4] TOTAL_BYTES | bit[20] CIRCULAR_MODE | bit[21] CLEAR</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ENABLE</name>
              <description>Enable the DMA TX channel</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MAX_BURST_LEN</name>
              <description>Singles-per-burst code: 0/1/2/3 correspond to 2/4/8/16</description>
              <bitOffset>1</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>BURST_MODE</name>
              <description>0=SINGLE only, 1=BURST</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>TOTAL_BYTES</name>
              <description>Total DMA TX bytes; DTI requires a multiple of 4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>CIRCULAR_MODE</name>
              <description>0=one-shot transfer, 1=continuous transfers</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CLEAR</name>
              <description>Clear transfer-complete state and rearm one-shot configuration</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
