              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DLF</name>
          <description>Divisor Latch Fraction Register bit[3:0] DLF</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>DLF</name>
              <description>4-bit fractional part of the baud-rate divisor in bits [3:0]</description>
