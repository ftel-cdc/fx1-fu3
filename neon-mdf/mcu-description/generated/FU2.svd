              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>RESERVED</name>
              <description>Reserved in bits [31:8]</description>
              <bitOffset>8</bitOffset>
              <bitWidth>24</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IN</name>
          <description>GPIO Input Data Register bit[7:0] IN</description>
          <addressOffset>0x18</addressOffset>
