          <name>LCR_EXT</name>
          <description>Line Extended Control Register bit[0] DLS_E | bit[1] ADDR_MATCH | bit[2] SEND_ADDR | bit[3] TRANSMIT_MODE</description>
          <addressOffset>0x3C</addressOffset>
