          <description>Alarm 1 channel 1 register bit[6:0] ALARM_SECOND | bit[13:7] ALARM_MINUTE | bit[19:14] ALARM_HOUR | bit[20] ALARM_EN | bit[21] ALARM_ON; ALARM_ON bit[21] is RO</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>INTR_INS0</name>
          <description>Event interrupt channel 0 register bit[7:0] INT_SECOND | bit[15:8] INT_MINUTE | bit[23:16] INT_HOUR | bit[24] INT_EN</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>INTR_INS1</name>
          <description>Event interrupt channel 1 register bit[7:0] INT_SECOND | bit[15:8] INT_MINUTE | bit[23:16] INT_HOUR | bit[24] INT_EN</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CSTW</name>
          <description>Control stopwatch register bit[0] ENABLE | bit[1] AUTO_SAVE</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
        </register>
        <register>
          <name>RSTW</name>
          <description>Reset stopwatch register bit[0] RESET</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CTSTW</name>
          <description>Capture stopwatch register bit[0] CAPTURE</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>TSTW</name>
          <description>Captured stopwatch time register (BCD) bit[7:0] MILLISECOND | bit[14:8] SECOND | bit[21:15] MINUTE | bit[29:22] HOUR</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>STT</name>
          <description>Status register bit[0] INT_TXFF_FULL | bit[1] INT_TXFF_EMPTY</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
        <register>
          <name>CLKS</name>
          <description>Clock status register (Read-to-Clear) bit[0] CLK_FAILURE | bit[8:1] ADDR_FAILURE | bit[9] CMD_FAILURE; read-to-clear</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
